# Server
PORT=8080

# Application environment: development | production
# In production the server refuses to start with a weak/placeholder JWT secret.
APP_ENV=development

# JWT Secret — MUST be a strong random string of at least 32 characters.
# Generate one with:  openssl rand -base64 48
# The app fails fast (panics on startup) if APP_ENV=production and this
# is missing, shorter than 32 chars, or still the placeholder below.
JWT_SECRET=change-me-in-production-use-a-strong-random-secret

# CORS allowed origins (comma-separated, no spaces).
# Leave empty in development to allow all origins (*).
# In production, list the exact origins that may call the API, e.g.:
#   CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com
# Native mobile apps do not send an Origin header and are always allowed.
CORS_ALLOWED_ORIGINS=

# Database (SQLite file path)
DB_PATH=./database.db

# Google Gemini API Key (for AI Coach + Food Scanner)
# Get a key at: https://aistudio.google.com/app/apikey
# Optional — AI endpoints fall back to simulated responses if absent.
GEMINI_API_KEY=

# Google Gemini Model (optional)
# The project is locked to gemini-3.5-flash. Override only if you know what you're doing.
GEMINI_MODEL=gemini-3.5-flash

# BestTime.app API Key (for real gym crowd/busyness data)
# Get a key at: https://besttime.app
# Optional — gym crowd endpoints fall back to simulated data if absent.
BESTTIME_API_KEY=

# BestTime API base URL (optional)
BESTTIME_API_URL=https://besttime.app/api/v1

# Google Places API Key (optional)
# Used for more accurate gym autocomplete. If absent, the app falls back
# to the free Nominatim (OpenStreetMap) autocomplete.
# Get a key at: https://developers.google.com/maps/documentation/places/web-service
GOOGLE_PLACES_API_KEY=

# Overpass API URL (optional)
# Free fallback for gym opening hours when Google Places is unavailable.
# Default: https://overpass-api.de/api/interpreter
OVERPASS_API_URL=
